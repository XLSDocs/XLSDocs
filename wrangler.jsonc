{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "xlsdocs",
  "workers_dev": true,
  "compatibility_date": "2026-08-03",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "html_handling": "none"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "xlsdocs"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "kv_namespaces": [
    {
      "binding": "FEEDBACK",
      "id": "925daacb91134dfa9c6835a256e52e08"
    }
  ],
  "routes": [
    { "pattern": "xlsdocs.com", "custom_domain": true },
    { "pattern": "www.xlsdocs.com", "custom_domain": true }
  ]
}
